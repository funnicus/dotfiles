[ -s "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

{{- $snyk := get . "snyk" | default dict }}
{{- if get $snyk "enabled" | default false }}
{{- $bitwardenItem := get $snyk "bitwardenItem" | default "" }}
{{- if $bitwardenItem }}
export SNYK_TOKEN={{ output "bw" "get" "password" $bitwardenItem "--nointeraction" | trim | squote }}
{{- end }}
{{- end }}
